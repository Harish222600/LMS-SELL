# ===========================================
# Beeja LMS Frontend Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your actual values
# Never commit the actual .env.local file to version control

# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API Base URL
# For development: http://localhost:5001
# For production: https://api.yourdomain.com
VITE_REACT_APP_BASE_URL=http://localhost:5001

# Alternative API URL (used in some components)
VITE_APP_BASE_URL=http://localhost:5001


# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Environment mode (automatically set by Vite)
# VITE_MODE=development

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================
# For production builds, make sure to:
# 1. Set VITE_REACT_APP_BASE_URL to your production API URL
# 2. Configure proper CORS on the backend
# 3. Use HTTPS URLs
# 4. Set up proper environment-specific configurations

# ===========================================
# FEATURE FLAGS (OPTIONAL)
# ===========================================
# You can add feature flags here if needed
# VITE_ENABLE_DEBUG_MODE=false
# VITE_ENABLE_ANALYTICS=true

# ===========================================
# NOTES
# ===========================================
# - All Vite environment variables must be prefixed with VITE_
# - Variables are available in the browser, so don't put sensitive data here
# - Use .env.local for local development overrides
# - Use .env.production for production builds
# - The backend handles all sensitive operations and API keys
NODE_ENV=development
PORT=5001
HOST=localhost
PUBLIC_IP=your_public_ip_here
MONGODB_URL=mongodb://localhost:27017/lms
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# ===========================================
# AWS S3 CONFIGURATION
# ===========================================
# AWS Credentials
AWS_ACCESS_KEY_ID=AKIAR435YEQRUIQYPDIH
AWS_SECRET_ACCESS_KEY=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
AWS_REGION=ap-south-1
# S3 Bucket Configuration
AWS_S3_BUCKET_NAME=beejas3

# CloudFront Distribution (optional, for CDN)
# AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.com

# S3 Auto-configuration (set to false to disable automatic bucket setup)
AUTO_CONFIGURE_S3=true

